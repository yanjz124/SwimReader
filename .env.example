# SwimReader — Centralized Credentials
# Copy this file to .env at the repo root and fill in your values.
# All services search upward for .env, so one file covers everything.

# ── SFDPS (SwimServer, port 5001) ─────────────────────────────────────────────
# En route flight data (FIXM XML) — powers the ERAM scope and flight table
SFDPS_HOST=tcps://ems2.swim.faa.gov:55443
SFDPS_VPN=FDPS
SFDPS_USER=your.email@example.com
SFDPS_PASS=your-swim-password
SFDPS_QUEUE=your.email@example.com.FDPS.your-uuid.OUT

# ── STDDS (SwimReader.Server, port 5000) ──────────────────────────────────────
# Terminal automation data: TAIS, TDES, SMES, APDS, ISMC
SCDSCONNECTION__HOST=tcps://ems2.swim.faa.gov:55443
SCDSCONNECTION__MESSAGEVPN=STDDS
SCDSCONNECTION__USERNAME=your-scds-username
SCDSCONNECTION__PASSWORD=your-scds-password
SCDSCONNECTION__QUEUENAME=your-username.STDDS.your-uuid.OUT

# ── TFMS (Traffic Flow Management System) ────────────────────────────────────
# Flight data, flow data, ground stops, GDP, reroutes, TMI
TFMS_HOST=tcps://ems2.swim.faa.gov:55443
TFMS_VPN=TFMS
TFMS_USER=your-tfms-username
TFMS_PASS=your-tfms-password
TFMS_QUEUE=your-username.TFMS.your-uuid.OUT

# ── ITWS (Integrated Terminal Weather System) ────────────────────────────────
# Terminal-area weather: precip, terminal winds, microbursts, gust fronts,
# lightning, storm cells. Powers the /itws frontend and /api/itws/* REST API
# (consumable by e.g. X-Plane weather plugins).
# Note: ITWS subscriptions are hosted on ems1 (not ems2).
ITWS_HOST=tcps://ems1.swim.faa.gov:55443
ITWS_VPN=ITWS
ITWS_USER=your-itws-username
ITWS_PASS=your-itws-password
ITWS_QUEUE=your-username.ITWS.your-uuid.OUT

# ── ADS-B (optional, for SwimReader.Server enrichment) ────────────────────────
# Custom adsb.fi API key (leave blank for public API with rate limits)
ADSBFI__APIKEY=

# Telegram bot (optional) — follow a flight over inflight free-messaging wifi.
# Create a bot with @BotFather and paste its token. Empty = bot disabled.
TELEGRAM_BOT_TOKEN=

# WhatsApp bot (optional) — same Track-a-Flight over WhatsApp (some inflight portals
# whitelist WhatsApp but not Telegram). Uses the Meta WhatsApp Cloud API (webhook-based).
# All three must be set or the bot is disabled. Setup:
#   1. Create a Meta app + WhatsApp product at developers.facebook.com; note the
#      phone-number ID (WHATSAPP_PHONE_ID) and generate a permanent access token
#      (WHATSAPP_TOKEN) via a System User.
#   2. Pick any secret string for WHATSAPP_VERIFY_TOKEN.
#   3. In the app's WhatsApp > Configuration, set the Callback URL to
#      https://swim.vncrcc.org/whatsapp/webhook, paste the same verify token, and
#      subscribe to the "messages" webhook field.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
