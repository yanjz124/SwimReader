<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC: the Pi has only 3.7 GB RAM and runs this alongside the
         SwimServer process. Server GC (default) keeps a heap per core and is
         very memory-hungry; Workstation GC keeps a single, far smaller heap. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwimReader.Core\SwimReader.Core.csproj" />
    <ProjectReference Include="..\SwimReader.Parsers\SwimReader.Parsers.csproj" />
    <ProjectReference Include="..\SwimReader.Scds\SwimReader.Scds.csproj" />
  </ItemGroup>

</Project>
