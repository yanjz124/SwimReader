<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Pi has only 3.7 GB RAM. Server GC (the ASP.NET Core default) keeps a
         separate heap per core and is very memory-hungry; Workstation GC keeps a
         single, much smaller heap — the right fit here (throughput is plenty for
         ~240 msg/s) and stops the process swapping the box to death. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SolaceSystems.Solclient.Messaging" Version="10.28.3" />
    <!-- BZip2 decompression for NEXRAD Level III symbology blocks
         (DescriptionBlock.ProductSpecific_8 == 1). Matches the version
         DGScope's NexradDecoder library pulls in. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
