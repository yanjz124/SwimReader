<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pi: RAM is ample (8 GB) but CPU is the scarce resource (shared with other services).
         Server GC (the ASP.NET Core default) keeps a heap per core and spends more CPU on
         parallel collections; Workstation GC keeps a single heap and is the right fit for
         ~240 msg/s of SFDPS throughput. RetainVM is on — with the airline-research index now
         keeping a multi-hundred-MB long-lived heap, letting the GC decommit/recommit segments
         every collection (the default) was costing real CPU in mmap/munmap and fragmentation
         for no memory benefit we need; keeping reclaimed segments reserved (not returned to the
         OS) trades a bit more steady-state RSS — which we have room for — for fewer syscalls. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SolaceSystems.Solclient.Messaging" Version="10.28.3" />
    <!-- BZip2 decompression for NEXRAD Level III symbology blocks
         (DescriptionBlock.ProductSpecific_8 == 1). Matches the version
         DGScope's NexradDecoder library pulls in. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- The ERAM scope's KML video maps live at the repo root and are served from
       RepoRoot. In a published/bundled build there is no .git to anchor RepoRoot,
       so copy the KMLs next to the exe (flattened via Link) and resolve them from
       the app base dir there (see Program.cs). Keeps the map working when SwimServer
       is bundled into SSG. -->
  <ItemGroup>
    <Content Include="..\..\*.kml">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
