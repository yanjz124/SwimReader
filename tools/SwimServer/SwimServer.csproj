<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pi: RAM is ample (8 GB) but CPU is the scarce resource (shared with other services).
         Server GC (the ASP.NET Core default) keeps a heap per core and spends more CPU on
         parallel collections; Workstation GC keeps a single heap and is the right fit for
         ~240 msg/s of SFDPS throughput.

         RetainVM was on for a while, on the reasoning that RAM was ample and keeping reclaimed
         segments reserved saved mmap/munmap churn. That stopped being true: the process reached
         5.0 GB RSS with a 4.4 GB heap and 53% fragmentation on an 8 GB box shared with other
         services, and started swapping to the SD card — measured 16-24% iowait with the flush
         worker permanently in D state. A history search alone grew the working set by 465 MB
         that was never returned. Give the segments back; the syscall cost is cheap next to
         swapping a multi-GB heap onto an SD card. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SolaceSystems.Solclient.Messaging" Version="10.28.3" />
    <!-- BZip2 decompression for NEXRAD Level III symbology blocks
         (DescriptionBlock.ProductSpecific_8 == 1). Matches the version
         DGScope's NexradDecoder library pulls in. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Runtime data directories live under the working dir but are NOT build inputs. The Web SDK's
       default content glob picks up **/*.json, which drags incident archives, the NASR cache, the
       aircraft DB and the flight cache into every build: hundreds of MB copied to bin/ each time,
       and a hard build FAILURE (MSB3030 "could not copy ... not found") if any of those files is
       removed while the build runs — e.g. an operator deleting an incident during a deploy, which
       silently broke auto-deploy. None of this is source; the app creates and reads it at runtime. -->
  <ItemGroup>
    <Content Remove="incidents/**" />
    <Content Remove="replay/**" />
    <Content Remove="flight-history/**" />
    <Content Remove="tdls-history/**" />
    <Content Remove="nasr-data/**" />
    <Content Remove="aircraft-db/**" />
    <Content Remove="flight-cache/**" />
    <Content Remove="crc-export/**" />
    <Content Remove="stars-profiles/**" />
    <Content Remove="ladd/**" />
    <None Remove="incidents/**" />
    <None Remove="replay/**" />
    <None Remove="flight-history/**" />
    <None Remove="tdls-history/**" />
    <None Remove="nasr-data/**" />
    <None Remove="aircraft-db/**" />
    <None Remove="flight-cache/**" />
    <None Remove="crc-export/**" />
    <None Remove="stars-profiles/**" />
    <None Remove="ladd/**" />
  </ItemGroup>

  <!-- The ERAM scope's KML video maps live at the repo root and are served from
       RepoRoot. In a published/bundled build there is no .git to anchor RepoRoot,
       so copy the KMLs next to the exe (flattened via Link) and resolve them from
       the app base dir there (see Program.cs). Keeps the map working when SwimServer
       is bundled into SSG. -->
  <ItemGroup>
    <Content Include="..\..\*.kml">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
